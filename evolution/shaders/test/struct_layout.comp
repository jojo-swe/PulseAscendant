#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

// Test fixture for material_test (compiled for the test only): copies every field of the structs the path
// tracer shares with the CPU, in declaration order, into a word buffer, then the shared constants and
// random.glsl's pcgHash of a few inputs (the CPU mirror rt::pcgHash must agree). The CPU
// filled each field with its own sentinel, so a field whose scalar-layout offset differs from the C++
// mirror's offsetof comes back with another field's value.

#include "../rt/random.glsl"
#include "../rt/types.glsl"

layout(local_size_x = 1) in;

layout(scalar, set = 0, binding = 0) readonly buffer Materials { Material materials[]; };
layout(scalar, set = 0, binding = 1) readonly buffer Lights { RectLight lights[]; };
layout(scalar, set = 0, binding = 2) readonly buffer Instances { InstanceRecord instances[]; };
layout(scalar, set = 0, binding = 3) readonly buffer Vertices { Vertex vertices[]; };
layout(scalar, set = 0, binding = 4) readonly buffer MeshRecords { MeshRecord meshRecords[]; };
layout(scalar, set = 0, binding = 5) writeonly buffer Words { uint words[]; };
layout(scalar, set = 0, binding = 6) readonly buffer Frames { FrameUniforms frames[]; };
layout(scalar, set = 0, binding = 7) readonly buffer Transforms { Mat34 transforms[]; };
layout(scalar, set = 0, binding = 8) readonly buffer Environments { EnvironmentUniforms environments[]; };
layout(scalar, set = 0, binding = 9) readonly buffer Media { MediumUniforms media[]; };
layout(scalar, set = 0, binding = 10) readonly buffer Spheres { SphereRecord spheres[]; };
layout(scalar, set = 0, binding = 11) readonly buffer TreeLights { TreeLight treeLights[]; };
layout(scalar, set = 0, binding = 12) readonly buffer TreeNodes { LightTreeNode treeNodes[]; };
layout(scalar, set = 0, binding = 13) readonly buffer Lenses { LensingUniforms lenses[]; };
layout(scalar, set = 0, binding = 14) readonly buffer Receivers { CausticReceiver receivers[]; };

const uint kElements = 2;

uint cursor = 0;

void putU(uint v) {
    words[cursor++] = v;
}

void putF(float v) {
    putU(floatBitsToUint(v));
}

void put2(vec2 v) {
    putF(v.x);
    putF(v.y);
}

void put3(vec3 v) {
    putF(v.x);
    putF(v.y);
    putF(v.z);
}

void put4(vec4 v) {
    put3(v.xyz);
    putF(v.w);
}

void main() {
    for (uint e = 0; e < kElements; ++e) {
        Material m = materials[e];
        put3(m.baseColor);
        putF(m.roughness);
        putF(m.metallic);
        putF(m.ior);
        putF(m.transmission);
        put3(m.emission);
        putF(m.emissionScale);
        putF(m.coat);
        putF(m.coatRoughness);
        putU(m.pattern);
        putU(m.texture);
        putF(m.patternScale);
        put3(m.baseColor2);
        putU(m.materialClass);
        putU(m.flags);
        putF(m.abbe);
        putU(m.medium);
        putU(m.receiver);
    }
    for (uint e = 0; e < kElements; ++e) {
        RectLight l = lights[e];
        put3(l.corner);
        put3(l.edgeU);
        put3(l.edgeV);
        put3(l.emission);
        putU(l.kind);
        putF(l.selectWeight);
        putF(l.area);
        putU(l.gate);
    }
    for (uint e = 0; e < kElements; ++e) {
        InstanceRecord r = instances[e];
        putU(r.mesh);
        putU(r.material);
        putU(r.light);
        putU(r.flags);
    }
    for (uint e = 0; e < kElements; ++e) {
        Vertex v = vertices[e];
        put3(v.position);
        put3(v.normal);
        put2(v.uv);
    }
    for (uint e = 0; e < kElements; ++e) {
        MeshRecord r = meshRecords[e];
        putU(r.firstVertex);
        putU(r.vertexCount);
        putU(r.firstIndex);
        putU(r.indexCount);
    }
    for (uint e = 0; e < kElements; ++e) {
        FrameUniforms f = frames[e];
        put3(f.cameraPosition);
        putF(f.tanHalfFovY);
        put3(f.cameraRight);
        putF(f.aspect);
        put3(f.cameraUp);
        putF(f.aperture);
        put3(f.cameraForward);
        putF(f.focusDistance);
        put3(f.prevPosition);
        putF(f.prevTanHalfFovY);
        put3(f.prevRight);
        putF(f.prevAspect);
        put3(f.prevUp);
        putU(f.prevValid);
        put3(f.prevForward);
        putF(f.pixelSpread);
        putU(f.width);
        putU(f.height);
        putU(f.frameSeed);
        putU(f.spp);
        putU(f.maxBounces);
        putU(f.flags);
        putU(f.lightCount);
        putU(f.instanceCount);
        putF(f.clampIndirect);
        putF(f.lightWeightSum);
        putF(f.regularizeRoughness);
        putU(f.treeLightCount);
        putU(f.mediumFlags);
        putU(f.causticReceivers);
        putU(f.lensing);
        putF(f.seconds);
        putF(f.shutterOffset);
        putF(f.environmentSelect);
        putU(f.sliceIndex);
        putU(f.sliceCount);
    }
    for (uint e = 0; e < kElements; ++e) {
        Mat34 m = transforms[e];
        put4(m.rows[0]);
        put4(m.rows[1]);
        put4(m.rows[2]);
    }
    for (uint e = 0; e < kElements; ++e) {
        EnvironmentUniforms v = environments[e];
        putU(v.kind);
        putF(v.intensity);
        putF(v.discCosRadius);
        putF(v.discShare);
        put3(v.discDirection);
        putF(v.domeShare);
        put3(v.discRadiance);
        putF(v.starDensity);
        put3(v.zenith);
        putF(v.starBrightness);
        put3(v.horizon);
        putF(v.townDensity);
        put3(v.ground);
        putF(v.haze);
        put3(v.glowDirection);
        putF(v.glowStrength);
    }
    for (uint e = 0; e < kElements; ++e) {
        MediumUniforms v = media[e];
        for (uint r = 0; r < 3; ++r) {
            putF(v.worldToMedium.rows[r].x);
            putF(v.worldToMedium.rows[r].y);
            putF(v.worldToMedium.rows[r].z);
            putF(v.worldToMedium.rows[r].w);
        }
        putU(v.gridSize.x);
        putU(v.gridSize.y);
        putU(v.gridSize.z);
        putF(v.densityScale);
        put3(v.gridAlbedo);
        putF(v.gridPhaseG);
        putU(v.majorantSize.x);
        putU(v.majorantSize.y);
        putU(v.majorantSize.z);
        putF(v.emissionScale);
        put3(v.fogAlbedo);
        putF(v.fogPhaseG);
        putF(v.fogDensity);
        putF(v.fogBaseHeight);
        putF(v.fogFalloff);
        putU(v.pad);
    }
    for (uint e = 0; e < kElements; ++e) {
        SphereRecord v = spheres[e];
        put3(v.center);
        putF(v.radius);
        put3(v.color);
        putU(v.material);
        put3(v.prevCenter);
        putF(v.emission);
    }
    for (uint e = 0; e < kElements; ++e) {
        TreeLight v = treeLights[e];
        put3(v.center);
        putF(v.radius);
        put3(v.emission);
        putU(v.sphere);
        putU(v.trail);
        putU(v.depth);
        putU(v.pad0);
        putU(v.pad1);
    }
    for (uint e = 0; e < kElements; ++e) {
        LightTreeNode v = treeNodes[e];
        put3(v.boundsMin);
        putF(v.power);
        put3(v.boundsMax);
        putU(v.child);
    }
    for (uint e = 0; e < kElements; ++e) {
        LensingUniforms v = lenses[e];
        put3(v.center);
        putF(v.massRadius);
        putF(v.influenceRadius);
        putU(v.steps);
        putU(v.flags);
        putF(v.stepScale);
    }

    for (uint e = 0; e < kElements; ++e) {
        CausticReceiver v = receivers[e];
        put4(v.worldToUv.rows[0]);
        put4(v.worldToUv.rows[1]);
        put4(v.worldToUv.rows[2]);
        putU(v.layer);
        putU(v.resolution);
        putU(v.pad0);
        putU(v.pad1);
    }

    putU(kMaterialPbr);
    putU(kMaterialGlass);
    putU(kMaterialEmissive);
    putU(kMaterialChecker);
    putU(kPatternNone);
    putU(kPatternWoodPlanks);
    putU(kPatternBrushedMetal);
    putU(kPatternConcrete);
    putU(kPatternTesserae);
    putU(kPatternTesseraeSphere);
    putU(kPatternHull);
    putU(kPatternPlanet);
    putU(kNoTexture);
    putU(kRetroScreenTexture);
    putU(kNoLight);
    putU(kLightEmitter);
    putU(kLightRetroScreen);
    putU(kLightPortal);
    putU(kTraceFlagNee);
    putU(kTraceFlagRussianRoulette);
    putU(kNoMedium);
    putU(kMaterialCameraOnlyEmission);
    putU(kMaterialCausticReceiver);
    putU(kMaterialThinWalled);
    putU(kLightTree);
    putU(kInstanceSpheres);
    putU(kInstanceDynamicSpheres);
    putU(kGeometryTriangles);
    putU(kGeometrySpheres);
    putU(kHitGroupsPerKind);
    putU(kNoReceiver);
    putU(kMediumFog);
    putU(kMediumGrid);
    putU(kPatternCityPunched);
    putU(kPatternCityCurtain);
    putU(kPatternCityBands);
    putU(kPatternCityRound);
    putU(kPatternCityStreet);
    putU(kPatternCityTrail);
    putU(kPatternCitySign);
    putU(kPatternSeaBead);
    putU(kPatternLightRing);
    putU(kPatternCrtGlass);
    putU(kPatternKeyCap);
    putU(kPatternWormholeWall);
    putU(kPatternWormholeRing);
    putU(kPatternPlasmaSea);

    // random.glsl's hash, against the CPU mirror rt::pcgHash (material_test's kHashInputs).
    const uint hashInputs[8] = uint[8](0u, 1u, 2u, 48000u, 0x9E3779B9u, 0x7FFFFFFFu, 0xFFFFFFFFu, 123456789u);
    for (uint i = 0; i < 8; ++i) {
        putU(pcgHash(hashInputs[i]));
    }
}
