#version 460
#extension GL_EXT_ray_tracing : require

// A test fixture for the shader binding table (tests/rt_pipeline_test.cpp): one ray per pixel along -z from
// the pixel's centre (pixel (x, y) at (x - width/2 + 0.5, y - height/2 + 0.5, 10)), and the payload the
// closest-hit (hit group k: k + 1) or miss shader (miss i: 100 + i) wrote goes to the output. Row `missRow`
// traces with miss index 1, every other row with miss index 0.

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, std430) writeonly buffer Out {
    uint values[];
};

layout(push_constant) uniform Push {
    uint width;
    uint height;
    uint missRow;
} pc;

layout(location = 0) rayPayloadEXT uint payload;

void main() {
    const uvec2 id = gl_LaunchIDEXT.xy;
    const vec3 origin = vec3(float(id.x) - 0.5 * float(pc.width) + 0.5,
                             float(id.y) - 0.5 * float(pc.height) + 0.5, 10.0);
    const uint missIndex = id.y == pc.missRow ? 1u : 0u;
    payload = 0u;
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 1, missIndex, origin, 0.0, vec3(0.0, 0.0, -1.0), 100.0,
                0);
    values[id.y * pc.width + id.x] = payload;
}
