#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

// Test fixture for material_test (compiled for the test only): samples and evaluates bsdf.glsl. One row of
// invocations per case (a material and the angle of wo from the shading normal), each invocation takes
// samplesPerThread samples and writes kResultFloats partial results, which the CPU reduces in a fixed order.
// The shading normal is tilted off every axis so the orthonormal basis is exercised as well.
//
// Results per invocation:
//   0-2  sum of weights of samples on wo's side      3-5  sum of weights of samples on the other side
//   6    largest weight component                    7    largest |pdf(sample) - pdf(eval)| / pdf(sample)
//   8    largest reciprocity error of f              9    largest |weight - f cos / pdf| / max(weight)
//   10   non-delta samples   11 delta samples   12 rejected samples   13 samples with a non-finite output
//   14   non-delta samples with pdf <= 0             15   largest | |wi| - 1 |
//   16   bsdfHasNonDeltaLobe(s) (1 or 0)

#include "../rt/types.glsl"
#include "../rt/random.glsl"
#include "../rt/bsdf.glsl"

layout(local_size_x = 64, local_size_y = 1) in;

struct ProbeCase {
    uint material;
    float thetaDegrees;
};

layout(scalar, set = 0, binding = 0) readonly buffer Materials { Material materials[]; };
layout(scalar, set = 0, binding = 1) readonly buffer Cases { ProbeCase cases[]; };
layout(scalar, set = 0, binding = 2) writeonly buffer Results { float results[]; };

layout(push_constant) uniform PushConstants {
    uint samplesPerThread;
    uint threadsPerCase;
    uint seed;
    uint caseCount;
} pc;

const uint kResultFloats = 17;

bool finite1(float x) {
    return !isnan(x) && !isinf(x);
}

bool finite3(vec3 v) {
    return !any(isnan(v)) && !any(isinf(v));
}

float maxComponent(vec3 v) {
    return max(v.x, max(v.y, v.z));
}

// Componentwise relative difference, 0 when both are 0.
float relativeError(vec3 a, vec3 b) {
    vec3 scale = max(abs(a), abs(b));
    vec3 e = vec3(0.0);
    for (int k = 0; k < 3; ++k) {
        e[k] = scale[k] > 0.0 ? abs(a[k] - b[k]) / scale[k] : 0.0;
    }
    return maxComponent(e);
}

void main() {
    uint thread = gl_GlobalInvocationID.x;
    uint caseIndex = gl_GlobalInvocationID.y;
    if (thread >= pc.threadsPerCase || caseIndex >= pc.caseCount) {
        return;
    }
    ProbeCase c = cases[caseIndex];
    Material m = materials[c.material];
    Surface s = Surface(m.baseColor, m.roughness, m.metallic, m.ior, m.transmission, m.coat, m.coatRoughness,
                        m.emission * m.emissionScale);

    vec3 n = normalize(vec3(0.3, -0.5, 0.8));
    vec3 t;
    vec3 b;
    orthonormalBasis(n, t, b);
    float theta = radians(c.thetaDegrees);
    vec3 wo = normalize(sin(theta) * t + cos(theta) * n);

    vec3 sumSame = vec3(0.0);
    vec3 sumOther = vec3(0.0);
    float maxWeight = 0.0;
    float maxPdfError = 0.0;
    float maxReciprocityError = 0.0;
    float maxWeightError = 0.0;
    float nonDelta = 0.0;
    float deltaCount = 0.0;
    float rejected = 0.0;
    float nonFinite = 0.0;
    float badPdf = 0.0;
    float maxUnitError = 0.0;

    for (uint i = 0; i < pc.samplesPerThread; ++i) {
        uint sampleIndex = thread * pc.samplesPerThread + i;
        uvec2 key = uvec2(sampleIndex, caseIndex);
        vec3 u = vec3(randomFloat(pc.seed, key, 0u, 0u), randomFloat(pc.seed, key, 0u, 1u),
                      randomFloat(pc.seed, key, 0u, 2u));
        vec3 wi;
        vec3 weight;
        float pdf;
        bool delta;
        if (!bsdfSample(s, n, wo, u, wi, weight, pdf, delta)) {
            rejected += 1.0;
            continue;
        }
        if (!finite3(wi) || !finite3(weight) || !finite1(pdf)) {
            nonFinite += 1.0;
            continue;
        }
        maxUnitError = max(maxUnitError, abs(length(wi) - 1.0));
        maxWeight = max(maxWeight, maxComponent(weight));
        if (dot(wi, n) * dot(wo, n) >= 0.0) {
            sumSame += weight;
        } else {
            sumOther += weight;
        }
        if (delta) {
            deltaCount += 1.0;
            continue;
        }
        nonDelta += 1.0;
        float pdfEval;
        vec3 f = bsdfEval(s, n, wo, wi, pdfEval);
        if (!finite3(f) || !finite1(pdfEval)) {
            nonFinite += 1.0;
            continue;
        }
        if (!(pdf > 0.0) || !(pdfEval > 0.0)) {
            badPdf += 1.0;
            continue;
        }
        maxPdfError = max(maxPdfError, abs(pdf - pdfEval) / pdf);
        maxWeightError = max(maxWeightError, relativeError(weight, f / pdfEval));
        if (dot(wi, n) * dot(wo, n) > 0.0) {
            float pdfReverse;
            vec3 fReverse = bsdfEval(s, n, wi, wo, pdfReverse);
            if (!finite3(fReverse) || !finite1(pdfReverse)) {
                nonFinite += 1.0;
                continue;
            }
            // eval returns f cos(wi); compare f itself both ways.
            maxReciprocityError = max(maxReciprocityError,
                                      relativeError(f / abs(dot(wi, n)), fReverse / abs(dot(wo, n))));
        }
    }

    uint base = (caseIndex * pc.threadsPerCase + thread) * kResultFloats;
    results[base + 0] = sumSame.x;
    results[base + 1] = sumSame.y;
    results[base + 2] = sumSame.z;
    results[base + 3] = sumOther.x;
    results[base + 4] = sumOther.y;
    results[base + 5] = sumOther.z;
    results[base + 6] = maxWeight;
    results[base + 7] = maxPdfError;
    results[base + 8] = maxReciprocityError;
    results[base + 9] = maxWeightError;
    results[base + 10] = nonDelta;
    results[base + 11] = deltaCount;
    results[base + 12] = rejected;
    results[base + 13] = nonFinite;
    results[base + 14] = badPdf;
    results[base + 15] = maxUnitError;
    results[base + 16] = bsdfHasNonDeltaLobe(s) ? 1.0 : 0.0;
}
