#version 460

// Maps the 320x200 palette index image to RGBA8 through the frame's 256-entry palette, which the CPU builds
// (cycling included) and uploads per retro frame.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, r8ui) uniform readonly uimage2D indexImage;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D colorImage;
layout(set = 0, binding = 2, std430) readonly buffer Palette {
    uint colors[256]; // RGBA8, red in the low byte
} palette;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(colorImage)))) {
        return;
    }
    uint index = imageLoad(indexImage, pixel).r & 0xffu;
    imageStore(colorImage, pixel, unpackUnorm4x8(palette.colors[index]));
}
