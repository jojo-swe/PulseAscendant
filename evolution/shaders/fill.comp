#version 460

// Test pattern: a 32-pixel checkerboard alternating a horizontal/vertical colour gradient with its
// inverse, plus a white circle that orbits the centre over time. Every headless test looks at this frame.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    float time;
    float pad;
} pc;

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }

    vec2 size = vec2(pc.width, pc.height);
    vec3 gradient = vec3(float(pixel.x) / size.x, float(pixel.y) / size.y, 0.0);
    vec3 inverse = vec3(1.0) - gradient;

    // Odd cells show the gradient, even cells (including the top-left one) its inverse.
    uvec2 cell = pixel / 32u;
    bool oddCell = ((cell.x + cell.y) & 1u) == 1u;
    vec3 color = oddCell ? gradient : inverse;

    vec2 center = vec2(0.5 + 0.3 * sin(pc.time), 0.5 + 0.3 * cos(pc.time)) * size;
    float radius = 0.2 * size.y;
    if (distance(vec2(pixel) + 0.5, center) <= radius) {
        color = vec3(1.0);
    }

    imageStore(outImage, ivec2(pixel), vec4(color, 1.0));
}
