#version 460
#extension GL_GOOGLE_include_directive : require

// The 1993 picture on the output: the 320x200 image fills a centred 4:3 rectangle (the output height times
// 4/3 wide, or the width times 3/4 high when the output is narrower than 4:3); everything outside it is
// black. Each pixel takes the nearest source pixel. With the CRT on, the same rectangle also gets
//   barrel     the picture bulges by 2 %, normalised so the corners stay put: the rectangle's edges still
//              sample the picture, so the content rectangle is identical with and without the CRT;
//   bloom      a source pixel takes 15 % of how much brighter its four neighbours are on average (1 px);
//   scanlines  odd source lines 25 % darker;
//   mask       a phosphor triad: in each output column, the two channels other than its own at -6 %;
//   vignette   darker towards the corners, by 10 % in the corners.
//
// Near a Portal chapter's glass (render/crt_view.hpp) the picture is magnified about a centre, as the camera
// closes in on the tube: the view maps the output's pixel to the picture by m = max(1, zoom * mix(1, w /
// content width, fill)) about `centre` (which the output's centre shows), and the look turns from the CRT
// above into the tube as the Studio's screen draws it up close (shaders/rt/screen.glsl): the beam's lines
// with a dark gap between them, the aperture grille's RGB stripes (three per source pixel) resolving below
// LOD -2, the bulge no longer stretched to the corners, in linear light. Black past the picture's edge.
// With zoom 1 and fill 0 none of this runs, so the output is the plain CRT above, byte for byte.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D retroImage; // 320x200
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D screen;    // width x height

// Must match CompositorPushConstants in src/render/compositor.cpp (48 bytes), shared by both of the
// compositor's passes (composite.comp reads the first 32).
layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    float era;
    float wipe;
    float eraCut;
    uint transition;
    uint crt;     // 0 = plain nearest-neighbour pillarbox
    uint visible; // bit 0 retro, bit 1 modern; without bit 0 the compositor skips this pass
    float zoom;   // the view near a Portal's glass (render/crt_view.hpp)
    float fill;
    vec2 centre;
} pc;

#include "crt_common.glsl"

vec3 source(ivec2 pixel) {
    return imageLoad(retroImage, clamp(pixel, ivec2(0), kRetroSize - 1)).rgb;
}

// The tube up close, as screen.glsl draws the Studio's screen: the beam's mean and its depth across a line,
// the grille's depth and its triads per source pixel.
const float kTubeBeamMean = 0.875;
const float kTubeBeam = 0.65;
const float kTubeGrille = 0.55;
const float kTubeTriads = 3.0;

vec3 toLinear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

vec3 toEncoded(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

// The magnified view (see the top): the picture about pc.centre at m = pc.zoom * ..., the plain CRT's look
// at m = 1 turning into the tube's by m = 1.35 (FLYBY's pull-out reaches the glass at 1.36 on 16:9).
vec3 magnified(uvec2 pixel, uvec4 rect) {
    vec2 content = vec2(rect.zw);
    float m = max(1.0, pc.zoom * mix(1.0, float(pc.width) / content.x, pc.fill));
    vec2 uv0 = (vec2(pixel) + 0.5 - vec2(rect.xy)) / content;
    vec2 uv = pc.centre + (uv0 - 0.5) / m;
    float tube = smoothstep(1.0, 1.35, m);

    vec2 centred = uv * 2.0 - 1.0;
    float r2 = dot(centred, centred);
    vec2 bulged = centred * (1.0 + kBarrel * r2) / (1.0 + 2.0 * kBarrel * (1.0 - tube));
    if (any(greaterThan(abs(bulged), vec2(1.0)))) {
        return vec3(0.0);
    }
    vec2 texel = (bulged * 0.5 + 0.5) * vec2(kRetroSize);
    ivec2 nearest = clamp(ivec2(floor(texel)), ivec2(0), kRetroSize - 1);
    vec3 color = source(nearest);
    if (pc.crt == 0u) {
        return color;
    }

    // The plain CRT's look at this sample.
    vec3 around = 0.25 * (source(nearest + ivec2(1, 0)) + source(nearest - ivec2(1, 0)) +
                          source(nearest + ivec2(0, 1)) + source(nearest - ivec2(0, 1)));
    vec3 plain = color + kBloom * max(around - color, 0.0);
    if ((nearest.y & 1) == 1) {
        plain *= kScanline;
    }
    vec3 mask = vec3(1.0 - kMask);
    mask[pixel.x % 3u] = 1.0;
    plain *= mask * (1.0 - kVignette * 0.5 * r2);

    // The tube's: the source line's beam and the grille at the footprint's level of detail.
    float lod = log2(float(kRetroSize.y) / (content.y * m));
    float lines = 1.0 - smoothstep(-0.5, 0.5, lod);
    vec3 light = toLinear(color) * kTubeBeamMean;
    light *= 1.0 + lines * kTubeBeam * cos(6.2831853 * (fract(texel.y) - 0.5));
    float grille = clamp(-lod - 2.0, 0.0, 1.0) * kTubeGrille;
    light *= 1.0 + grille * cos(6.2831853 * (texel.x * kTubeTriads - vec3(0.0, 1.0 / 3.0, 2.0 / 3.0)));
    light *= 1.0 - kVignette * 0.5 * r2;
    vec3 near = toEncoded(clamp(light, 0.0, 1.0));

    return clamp(mix(plain, near, tube), 0.0, 1.0);
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }

    uvec4 rect = crtContentRect(pc.width, pc.height);
    if (pc.zoom != 1.0 || pc.fill != 0.0) {
        imageStore(screen, ivec2(pixel), vec4(magnified(pixel, rect), 1.0));
        return;
    }
    uvec2 origin = rect.xy;
    uvec2 content = rect.zw;
    if (any(lessThan(pixel, origin)) || any(greaterThanEqual(pixel, origin + content))) {
        imageStore(screen, ivec2(pixel), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    vec2 uv = (vec2(pixel - origin) + 0.5) / vec2(content); // (0, 1) across the rectangle
    if (pc.crt == 0u) {
        ivec2 nearest = ivec2(uv * vec2(kRetroSize));
        imageStore(screen, ivec2(pixel), vec4(source(nearest), 1.0));
        return;
    }

    vec2 centred = uv * 2.0 - 1.0;
    float r2 = dot(centred, centred); // 2 in the corners
    vec2 bulged = crtBulge(centred);
    ivec2 nearest = ivec2(floor((bulged * 0.5 + 0.5) * vec2(kRetroSize)));
    nearest = clamp(nearest, ivec2(0), kRetroSize - 1);

    vec3 color = source(nearest);
    vec3 around = 0.25 * (source(nearest + ivec2(1, 0)) + source(nearest - ivec2(1, 0)) +
                          source(nearest + ivec2(0, 1)) + source(nearest - ivec2(0, 1)));
    color += kBloom * max(around - color, 0.0);
    if ((nearest.y & 1) == 1) {
        color *= kScanline;
    }
    vec3 mask = vec3(1.0 - kMask);
    mask[pixel.x % 3u] = 1.0;
    color *= mask;
    color *= 1.0 - kVignette * 0.5 * r2;

    imageStore(screen, ivec2(pixel), vec4(clamp(color, 0.0, 1.0), 1.0));
}
