#version 460
#extension GL_GOOGLE_include_directive : require

// The Nebula scene's grid medium (src/modern/scenes/nebula.hpp describes the scene): one
// voxel per invocation, (density, emission rgb), a pure function of (uvw, seconds, params). Three modes
// (params[0].x):
//
// 0, NEBULA: a dust ridge with four pillars (bowed, bulging tubes with swollen heads, warped and eroded by
// gradient noise into vertical striations), patchy dust lanes in front, and the thin gas of a cavity that
// star A has blown clear round itself and piled into a shell. The emission is the gas's response to the
// three stars: from every dusty voxel the bake marches towards each star (8 steps out to 30 units, the first
// through the full density) and attenuates the star's flux by the gas in front of it, so the light that
// reaches a voxel is the light that was not absorbed nearer the star. Recombination glows with density^2 x
// that flux: a thin, hard-edged skin on every surface facing a star (an ionisation front), ice-white where
// the flux is strong, gold where it is weaker; heated dust a little deeper glows ember with density x flux
// (it penetrates 3x deeper); the cavity's ionised gas glows ice blue in wisps; knots in the pillar heads
// pulse with the bass. A's fronts burn whiter and stronger than the lesser stars'; B's light dies in the gap's
// gas past the flank it faces, so the pillars' sides away from A stay dark dust, rimmed by A's fronts and
// carved into ribs and globules (the first steps of every march go through the full dust, so the ribs
// shadow each other). The voxel stores the emission that gives that emissivity at its density.
//
// 1, PLASMA: the 1993 plasma (shaders/retro/plasma.comp, here at continuous pixel positions and time) in
// (x, y) over the slab's mid-plane, its pixel grid kPlasmaPixel wide, warped more the further a voxel lies
// from the mid-plane; the slab's half thickness follows the field. Its faces are a continuous skin; inside,
// the gas is drawn into strands with hard fronts and dark gaps. The emission is the 1993 palette ring at
// the voxel's ring position (the field folded three times round the 224 entries, as the 1993 effect indexes
// it, plus the rotation), linear light.
//
// 2, PLASMA PLANET: the planet's air and its cumulus (src/modern/scenes/nebula.hpp has the planet). The clouds
// are density that scatters for real (the grid's albedo and phase are theirs); the air holds only a share of
// its extinction, and its light is baked as emission: the sun's single scattering (Rayleigh and Mie phase)
// towards the frame's eye, after the air's extinction on the way in from the sun and the planet's shadow, so
// the limb glows blue in forward scatter and the terminator burns orange.
//
// params[0] = (mode, field time (chapter seconds), bass, energy); PLASMA PLANET (mode, chapter seconds, the
//             sun's irradiance, 0)
// params[1] = (box lo xyz, 0; PLASMA PLANET the planet's radius), params[2] = (box hi xyz, 0; PLASMA PLANET 1
// with the clouds: the low pass's cloud shell; the orbit's grid is too coarse for them); PLASMA PLANET
// params[3] = (the eye, 0)
// params[3] = NEBULA (ionising opacity per unit density, the grid's density scale, the eye's z, the shafts'
//             gain; the eye's x and y are params[1].w and params[2].w); PLASMA (ring shift, emission gain, 0, 0)
// The tracer emits sigma_t (1 - albedo) Le per unit length, so the emission is stored divided by that factor
// (NEBULA's albedo is modern::kNebulaAlbedo, PLASMA's grey: kPlasmaAlbedo, PLASMA PLANET's the clouds').

#include "medium_common.glsl"

// --- Noise (integer hashes only) ---------------------------------------------------------------------------

uint nebulaHash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

vec3 latticeGradient(ivec3 c) {
    uint h = nebulaHash(uint(c.x) * 0x8da6b343u ^ uint(c.y) * 0xd8163841u ^ uint(c.z) * 0xcb1ab31fu);
    return vec3(float(h & 1023u), float((h >> 10) & 1023u), float((h >> 20) & 1023u)) / 511.5 - 1.0;
}

// Gradient noise, about [-1, 1].
float gradientNoise(vec3 p) {
    vec3 cell = floor(p);
    ivec3 i = ivec3(cell);
    vec3 f = p - cell;
    vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    float n000 = dot(latticeGradient(i), f);
    float n100 = dot(latticeGradient(i + ivec3(1, 0, 0)), f - vec3(1.0, 0.0, 0.0));
    float n010 = dot(latticeGradient(i + ivec3(0, 1, 0)), f - vec3(0.0, 1.0, 0.0));
    float n110 = dot(latticeGradient(i + ivec3(1, 1, 0)), f - vec3(1.0, 1.0, 0.0));
    float n001 = dot(latticeGradient(i + ivec3(0, 0, 1)), f - vec3(0.0, 0.0, 1.0));
    float n101 = dot(latticeGradient(i + ivec3(1, 0, 1)), f - vec3(1.0, 0.0, 1.0));
    float n011 = dot(latticeGradient(i + ivec3(0, 1, 1)), f - vec3(0.0, 1.0, 1.0));
    float n111 = dot(latticeGradient(i + ivec3(1, 1, 1)), f - vec3(1.0, 1.0, 1.0));
    float x0 = mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y);
    float x1 = mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y);
    return 1.4 * mix(x0, x1, u.z);
}

// Octaves turned against each other, so no lattice axis shows.
const mat3 kOctaveTurn = mat3(0.00, 0.80, 0.60, -0.80, 0.36, -0.48, -0.60, -0.48, 0.64);

float fbm(vec3 p, int octaves) {
    float sum = 0.0;
    float amplitude = 0.5;
    for (int i = 0; i < octaves; ++i) {
        sum += amplitude * gradientNoise(p);
        p = kOctaveTurn * p * 2.03 + vec3(11.7, -3.1, 5.3);
        amplitude *= 0.5;
    }
    return sum;
}

// Ridges (sharp creases where the noise crosses 0), in [0, 1].
float ridged(vec3 p, int octaves) {
    float sum = 0.0;
    float amplitude = 0.5;
    float norm = 0.0;
    for (int i = 0; i < octaves; ++i) {
        float r = 1.0 - abs(gradientNoise(p));
        sum += amplitude * r * r;
        norm += amplitude;
        p = kOctaveTurn * p * 2.07 + vec3(-7.3, 4.9, 1.1);
        amplitude *= 0.5;
    }
    return sum / norm;
}

// 1 inside the box, falling to 0 over `margin` at its faces: no medium ever ends at the box's edge.
float boxFade(vec3 p, vec3 lo, vec3 hi, float margin) {
    vec3 inside = min(p - lo, hi - p);
    return smoothstep(0.0, margin, min(min(inside.x, inside.y), inside.z));
}

// --- NEBULA ------------------------------------------------------------------------------------------------
// modern::kNebulaPillars, kNebulaPillarBow, kNebulaStarCentres and kNebulaStarRadii (src/modern/scenes/nebula.hpp).

const vec3 kPillarBase[4] = vec3[4](vec3(-40.0, -48.0, -30.0), vec3(-2.0, -48.0, -38.0), vec3(32.0, -48.0, -26.0),
                                    vec3(60.0, -48.0, -44.0));
const vec3 kPillarTop[4] = vec3[4](vec3(-44.0, 30.0, -36.0), vec3(6.0, 46.0, -46.0), vec3(36.0, 14.0, -30.0),
                                   vec3(58.0, -6.0, -46.0));
const float kPillarBaseRadius[4] = float[4](11.0, 12.0, 9.0, 7.0);
const float kPillarTopRadius[4] = float[4](7.5, 8.0, 6.5, 5.0);
const vec3 kPillarBow[4] = vec3[4](vec3(-3.0, 0.0, 2.0), vec3(4.0, 0.0, -2.0), vec3(-2.5, 0.0, 3.0), vec3(2.0, 0.0, 0.0));

const vec3 kStarCentre[3] = vec3[3](vec3(20.0, 18.0, -90.0), vec3(-27.0, -10.0, -26.0), vec3(35.0, 16.0, -30.0));
const float kStarRadius[3] = float[3](0.9, 0.8, 0.5);
// Each star's ionising output (flux at unit distance, before the gas absorbs it).
const float kStarOutput[3] = float[3](5200.0, 900.0, 160.0);
// Star A's bubble: the gas it has blown away (inside kBubbleInner) and the shell it has piled up round it.
const float kBubbleInner = 16.0;
const float kBubbleShell = 44.0;
// The gas round star B: clear for kGapClear units, then this much density along the way.
const float kGapClear = 6.0;
const float kGapGas = 0.14;
// How much brighter star A's ionisation fronts burn than the others' at the same flux.
const float kHeroFront = 2.2;

const vec3 kIce = vec3(0.55, 0.75, 1.0);
const vec3 kGold = vec3(1.0, 0.66, 0.30);
const vec3 kEmber = vec3(1.0, 0.34, 0.08);
const vec3 kNebulaAlbedo = vec3(0.5, 0.37, 0.26); // modern::kNebulaAlbedo

// modern::nebulaPillarDistance's pieces: pillar i's bent axis and its radius at height fraction h (bowed,
// wobbling, with bulges and a swollen head).
vec3 pillarAxis(int i, float h) {
    float fi = float(i);
    return mix(kPillarBase[i], kPillarTop[i], h) + kPillarBow[i] * sin(3.14159265 * h) +
           vec3(1.6 * sin(5.1 * h + 1.7 * fi), 0.0, 1.6 * cos(4.3 * h + 2.3 * fi));
}

float pillarRadius(int i, float h) {
    float r = mix(kPillarBaseRadius[i], kPillarTopRadius[i], h) * (1.0 + 0.16 * sin(8.7 * h + 1.3 * float(i)));
    float head = (h - 0.9) / 0.08;
    return r + 0.45 * kPillarTopRadius[i] * exp(-head * head);
}

// modern::nebulaPillarDistance: the pillars' signed distance before the noise (h from the straight axis).
float pillarDistance(vec3 p) {
    float d = 1e9;
    for (int i = 0; i < 4; ++i) {
        vec3 ab = kPillarTop[i] - kPillarBase[i];
        float h = clamp(dot(p - kPillarBase[i], ab) / dot(ab, ab), 0.0, 1.0);
        d = min(d, length(p - pillarAxis(i, h)) - pillarRadius(i, h));
    }
    return d;
}

// The ridge: its top rises gently behind and falls at a cliff in front (z ~ -4 .. 22).
float ridgeDistance(vec3 p) {
    float top = -38.0 + 5.0 * fbm(vec3(p.x * 0.035, 0.0, p.z * 0.035), 2) - 30.0 * smoothstep(-4.0, 22.0, p.z);
    return p.y - top;
}

float smoothUnion(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// Dust lanes drifting across the front of the wall: thin creased sheets, patchy.
float nebulaLanes(vec3 p) {
    if (p.z < -12.0) {
        return 0.0;
    }
    float band = exp(-pow((p.y + 18.0 - 0.25 * p.x) / 16.0, 2.0)) + 0.6 * exp(-pow((p.y - 38.0 + 0.3 * p.x) / 9.0, 2.0));
    if (!(band > 0.02)) {
        return 0.0;
    }
    float crease = ridged(vec3(p.x * 0.022, p.y * 0.05, p.z * 0.03) + vec3(4.2, 0.0, 0.0), 3);
    float patchy = smoothstep(0.05, 0.45, fbm(p * 0.02 + vec3(-7.0, 2.0, 9.0), 2) + 0.2);
    return 0.12 * smoothstep(0.6, 0.92, crease) * patchy * band;
}

// The dust's density (about 1 inside the pillars and the ridge; the lanes thin). `fine` adds the warp, the
// erosion's small octaves (vertical striations along the pillars, as photoevaporation carves them) and the
// lanes; the marches' far steps use the coarse field. The noise moves the surface by at most
// modern::kNebulaPillarNoise.
float nebulaDust(vec3 p, float t, bool fine) {
    vec3 q = p;
    if (fine) {
        // A slow large-scale warp (at most ~1.5 units): the shapes breathe without moving the reveal.
        vec3 w = p * 0.045 + vec3(0.0, 0.0, 0.02 * t);
        q += 1.5 * vec3(gradientNoise(w), gradientNoise(w + vec3(31.4, 7.7, -12.9)), gradientNoise(w - vec3(5.3, 19.1, 8.8)));
    }
    float d = smoothUnion(pillarDistance(q), ridgeDistance(q), 6.0);
    float lanes = fine ? nebulaLanes(p) : 0.0;
    if (d > 5.0) {
        return lanes; // beyond any octave's reach
    }
    float erosion = fine ? 1.6 * fbm(p * 0.13, 3) + 1.8 * (ridged(vec3(p.x * 0.22, p.y * 0.05, p.z * 0.22), 2) - 0.55) +
                               0.4 * gradientNoise(p * 0.9)
                         : 0.7 * gradientNoise(p * 0.2);
    float solid = smoothstep(0.5, -0.9, d + erosion);
    float body = solid * (fine ? 0.75 + 0.3 * gradientNoise(p * 0.07 + 3.1) + 0.2 * gradientNoise(p * 0.31) : 0.8);
    return max(body, 0.0) + lanes;
}

// The structure of the cavity's gas and of its ionised glow (about [0, 1.5]): broad sheets, creased into
// filaments where they fold.
float nebulaWisps(vec3 p, float t) {
    vec3 q = p * 0.035 + vec3(0.0, 0.0, 0.01 * t);
    float sheets = 0.55 + 0.9 * fbm(q, 3);
    float creases = ridged(q * 2.3 + vec3(1.7, -4.1, 0.6), 3);
    return clamp(sheets * (0.35 + 0.9 * creases * creases), 0.0, 1.5);
}

// The cavity's thin gas: evacuated round star A, piled up in a shell at kBubbleShell, in slow sheets.
float nebulaCavity(vec3 p, float wisps) {
    float r = length(p - kStarCentre[0]);
    float shell = (r - kBubbleShell) / 9.0;
    return (0.0022 * smoothstep(kBubbleInner, kBubbleShell, r) + 0.0035 * exp(-shell * shell)) * (0.2 + wisps * wisps);
}
const float kCavityMean = 0.003;

// The gas's column density from p towards a star along dir, out to `reach` (at most 30 units, in `steps` of
// growing length): the first step through the full dust (it draws the front's edge), the rest coarse; the
// cavity at its mean.
const int kFineSteps = 3; // the steps through the full dust: out to 2.8 units, past a rib's groove
float nebulaColumn(vec3 p, vec3 dir, float reach, float t, int steps) {
    const float kSteps[8] = float[8](0.6, 1.5, 2.8, 4.8, 7.8, 12.0, 19.0, 30.0);
    float sum = kCavityMean * reach;
    float s0 = 0.0;
    for (int i = 0; i < steps; ++i) {
        float s1 = min(kSteps[i], reach);
        if (!(s1 > s0)) {
            break;
        }
        float mid = 0.5 * (s0 + s1);
        sum += nebulaDust(p + dir * mid, t, i < kFineSteps) * (s1 - s0);
        s0 = s1;
    }
    return sum;
}

// The pillars' shadow on the cavity's gas: their optical depth from p towards a star `reach` away, from the
// analytic pillars alone (no noise: the cavity is most of the grid, and its shafts only need the pillars'
// silhouettes), sampled at 10 points out to 110 units.
float nebulaPillarShadow(vec3 p, vec3 dir, float reach, float opacity) {
    float span = min(reach, 110.0);
    float ds = span / 10.0;
    float sum = 0.0;
    for (int i = 0; i < 10; ++i) {
        sum += smoothstep(1.5, -2.5, pillarDistance(p + dir * ((float(i) + 0.5) * ds)));
    }
    return opacity * 0.9 * sum * ds;
}

// Henyey-Greenstein's phase function.
float nebulaPhase(float cosine, float g) {
    float g2 = g * g;
    return 0.0795775 * (1.0 - g2) / pow(max(1.0 + g2 - 2.0 * g * cosine, 1e-4), 1.5);
}

// densityScale: the grid's sigma_t per unit of rho, so that the voxel stores the emission giving the
// emissivity j it wants (gba = j / (sigma_t (1 - albedo))). The cavity's gas also scatters star A's light
// towards the eye (forward, g kShaftG), after the gas and the pillars between it and A: baked for the frame's
// eye, so the pillars' edges cut shafts out of A's light that fan towards the camera.
const float kShaftG = 0.78;

vec4 nebulaVoxel(vec3 p, float t, float bass, float opacity, float densityScale, vec3 lo, vec3 hi, vec3 eye,
                 float shaft) {
    float fade = boxFade(p, lo, hi, 12.0);
    if (!(fade > 0.0)) {
        return vec4(0.0);
    }
    float dust = nebulaDust(p, t, true);
    float wisps = nebulaWisps(p, t);
    float rho = fade * (dust + nebulaCavity(p, wisps));
    float inBubble = smoothstep(0.6 * kBubbleInner, kBubbleShell, length(p - kStarCentre[0]));
    // The fronts are not lit evenly: photoevaporation carves them into vertical striations and globules, so a
    // front facing the camera reads as relief, bright ribs over darker grooves.
    float ribs = ridged(vec3(p.x * 0.24, p.y * 0.05, p.z * 0.24) + vec3(3.3, 0.0, -1.7), 2);
    float globules = smoothstep(-0.15, 0.35, fbm(p * 0.16 + vec3(-2.9, 6.1, 0.4), 2));
    float relief = 0.08 + 2.4 * ribs * ribs * ribs * (0.35 + 0.65 * globules);
    vec3 j = vec3(0.0); // the emissivity: radiance emitted per unit length
    for (int k = 0; k < 3; ++k) {
        vec3 toStar = kStarCentre[k] - p;
        float r = length(toStar);
        float reach = r - kStarRadius[k];
        if (!(reach > 0.0)) {
            continue;
        }
        float flux = kStarOutput[k] / (r * r + 4.0);
        if (flux < 0.05) {
            continue; // too far for its light to show against the others'
        }
        // The dust's fronts need the march; the cavity's gas towards A takes the pillars' analytic shadow (in
        // its glow and in A's shafts). Thin gas lit by B and C stands as it is. C, inside its pillar's head,
        // only needs the head's own gas.
        float tau = dust > 0.02 ? opacity * nebulaColumn(p, toStar / r, reach, t, k == 2 ? 4 : 8)
                    : opacity * kCavityMean * reach + (k == 0 ? nebulaPillarShadow(p, toStar / r, reach, opacity) : 0.0);
        // B sits in the gap's denser gas: its light ionises the flank it faces, a few units away, and dies out
        // before the centre pillar, whose face towards the camera stays dark dust.
        tau += k == 1 ? opacity * kGapGas * max(reach - kGapClear, 0.0) : 0.0;
        float skin = flux * exp(-tau);
        float heated = flux * exp(-tau / 3.0);
        vec3 tint = mix(kGold, kIce, smoothstep(0.6, 8.0, skin));
        // A's fronts are the bright ones: its skins burn whiter and stronger than the lesser stars'.
        float front = k == 0 ? kHeroFront : 1.0;
        if (k == 0) {
            tint = mix(kGold, kIce, smoothstep(0.3, 4.0, skin));
        }
        // Recombination in the dust's ionised skin (~ density^2), heated dust deeper in (~ density), and the
        // cavity's ionised gas, ice blue, in its wisps.
        j += densityScale * (front * tint * skin * dust * (dust + 0.1) * relief + kEmber * (0.08 * heated * dust * relief) +
                             kIce * (0.02 * skin * wisps * wisps * wisps * wisps * inBubble));
        if (k == 0 && shaft > 0.0) {
            float cosine = dot(-toStar / r, normalize(eye - p));
            float gas = rho - dust; // the cavity's, not the dust's (the dust scatters for real)
            j += densityScale * shaft * vec3(0.72, 0.82, 1.0) * (2.5 * gas * skin * nebulaPhase(cosine, kShaftG));
        }
    }
    // Knots in the pillar heads, on the sides facing the hero star, pulsing with the bass.
    if (dust > 0.15) {
        for (int k = 0; k < 12; ++k) {
            int i = k % 4;
            uint h = nebulaHash(uint(k) * 0x9E3779B9u + 17u);
            vec3 jitter = vec3(float(h & 255u), float((h >> 8) & 255u), float((h >> 16) & 255u)) / 127.5 - 1.0;
            vec3 toward = normalize(kStarCentre[0] - kPillarTop[i]);
            vec3 centre = kPillarTop[i] + kPillarTopRadius[i] * (0.75 * toward + 0.45 * jitter);
            float size = 1.1 + 0.9 * float((h >> 24) & 255u) / 255.0;
            vec3 o = (p - centre) / size;
            j += densityScale * kGold * (0.9 * (0.4 + 1.2 * bass) * exp(-dot(o, o)) * smoothstep(0.15, 0.6, dust));
        }
    }
    // The stored emission, capped so that a thin voxel's never swamps a dense neighbour's when interpolated.
    vec3 le = fade * j / (densityScale * max(rho, 1e-3) * (1.0 - kNebulaAlbedo));
    return vec4(rho, min(le, vec3(120.0)));
}

// --- PLASMA ------------------------------------------------------------------------------------------------
// modern::plasmaField, plasmaRingIndex and plasmaRingColour (src/modern/scenes/nebula.cpp).

const float kPlasmaPixel = 0.1;    // modern::kPlasmaPixel
const float kPixelAspect = 1.2;    // the 320x200 pixels' aspect, as shaders/retro/plasma.comp
const float kPlasmaFolds = 3.0;    // shaders/retro/plasma.comp's kFolds
const float kRingEntries = 224.0;  // retro::kPlasmaColours
const float kPlasmaAlbedo = 0.55;  // modern::kPlasmaAlbedo (grey)

float plasmaField(vec2 p, float t) {
    vec2 screen = vec2(p.x, p.y * kPixelAspect);
    vec2 centre1 = vec2(160.0 + 120.0 * sin(t * 0.31), (100.0 + 75.0 * sin(t * 0.43 + 1.0)) * kPixelAspect);
    vec2 centre2 = vec2(160.0 + 110.0 * cos(t * 0.27 + 2.0), (100.0 + 80.0 * cos(t * 0.37)) * kPixelAspect);
    float field = sin(p.x / 41.0 + t * 0.83);
    field += sin(p.y / 29.0 - t * 0.61);
    field += sin((p.x + p.y) / 53.0 + t * 0.47);
    field += sin(length(screen - centre1) / 17.0 - t * 1.30);
    field += sin(length(screen - centre2) / 23.0 + t * 0.90);
    field += 0.5 * sin(p.x / 13.0 + 2.0 * sin(p.y / 19.0 + t * 0.70) + t);
    field += 0.5 * sin(p.y / 11.0 + 2.0 * sin(p.x / 23.0 - t * 0.55));
    return field / 6.0;
}

// The ring's six stops and three gradients (src/retro/palettes.cpp): violet, magenta, orange, yellow, cyan,
// deep blue; 75, 75 and 74 entries.
vec3 ringMix(vec3 a, vec3 b, float t) {
    return floor(a + (b - a) * t + 0.5); // std::lround of non-negative values
}

vec3 ringColour(uint entry) {
    const vec3 kViolet = vec3(40.0, 0.0, 90.0);
    const vec3 kMagenta = vec3(210.0, 20.0, 170.0);
    const vec3 kOrange = vec3(255.0, 120.0, 20.0);
    const vec3 kYellow = vec3(255.0, 235.0, 90.0);
    const vec3 kCyan = vec3(40.0, 220.0, 235.0);
    const vec3 kDeepBlue = vec3(10.0, 30.0, 140.0);
    vec3 from = kViolet, middle = kMagenta, to = kOrange;
    float span = 75.0;
    float i = float(entry);
    if (entry >= 150u) {
        from = kCyan;
        middle = kDeepBlue;
        to = kViolet;
        span = 74.0;
        i -= 150.0;
    } else if (entry >= 75u) {
        from = kOrange;
        middle = kYellow;
        to = kCyan;
        i -= 75.0;
    }
    float t = 2.0 * i / span;
    vec3 c = t < 1.0 ? ringMix(from, middle, t) : ringMix(middle, to, t - 1.0);
    return c / 255.0;
}

vec3 srgbToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

vec4 plasmaVoxel(vec3 p, float t, float shift, float gain, vec3 lo, vec3 hi) {
    float depth = abs(p.z) / 12.0;
    vec3 wq = vec3(p.x * 0.16, p.y * 0.16, p.z * 0.2 + 0.12 * t);
    vec2 warp = vec2(gradientNoise(wq), gradientNoise(wq + vec3(17.3, -9.1, 4.7))) * (1.5 + 9.0 * depth);
    vec2 pixel = vec2(p.x / kPlasmaPixel + 160.0, 100.0 - p.y / (kPlasmaPixel * kPixelAspect)) + warp;
    float field = plasmaField(pixel, t);
    float level = clamp(0.5 + 0.5 * field, 0.0, 1.0);
    // The slab: thicker where the field is high, its faces billowing.
    float halfThickness = 5.0 + 3.2 * field + 1.0 * gradientNoise(vec3(p.xy * 0.25, 0.25 * t + 3.0));
    float erosion = 1.0 * fbm(p * 0.6 + vec3(0.0, 0.0, 0.1 * t), 4) + 0.3 * (ridged(p * 1.7, 2) - 0.5);
    float surface = abs(p.z) - halfThickness + erosion; // < 0 inside
    float inside = smoothstep(0.6, -1.0, surface);
    // The faces are a continuous skin (the 1993 picture, so the wipe's seam does not show); behind them the gas
    // is drawn into strands with hard fronts (the ridges of a warped noise, cut sharp), with dark gaps between,
    // so the cloud has depth when the camera is inside it.
    // The skin is the face the 1993 picture is on (the front, +z); behind the strands lies the dark.
    float skin = exp(-pow((surface + 0.35) / 0.75, 2.0)) * smoothstep(-1.0, 1.0, p.z);
    vec3 sq = vec3(p.x * 0.17, p.y * 0.17, p.z * 0.3) + vec3(0.05 * t, 0.0, 0.0) +
              1.4 * vec3(gradientNoise(p * 0.09 + 2.3), gradientNoise(p * 0.09 - 5.1), 0.0);
    float strands = smoothstep(0.42, 0.78, ridged(sq, 3)) * (0.55 + 0.6 * ridged(sq * 3.1 + vec3(5.2, -1.3, 2.7), 2));
    float rho = inside * (0.85 * skin + (1.0 - 0.85 * skin) * (0.015 + 1.5 * strands));
    rho *= 0.7 + 0.5 * ridged(p * 0.35 + vec3(0.2 * t, 0.0, 0.0), 2);
    rho *= boxFade(p, lo, hi, 1.5);
    if (!(rho > 1e-4)) {
        return vec4(0.0);
    }
    // The ring position as the 1993 effect indexes it, plus the rotation; between two entries, a blend.
    float position = mod(floor(level * kPlasmaFolds * kRingEntries) + shift, kRingEntries);
    uint entry = uint(position);
    vec3 colour = mix(ringColour(entry), ringColour((entry + 1u) % 224u), fract(position));
    // The faces glow brightest (a front), the strands' cores bright, the gaps dim, so the slab's relief reads.
    float front = exp(-pow((surface + 0.3) / 0.9, 2.0));
    return vec4(rho, gain * (0.08 + 1.4 * front * smoothstep(-1.0, 1.0, p.z) + 1.6 * strands) * srgbToLinear(colour) /
                         (1.0 - kPlasmaAlbedo));
}

// --- PLASMA PLANET -------------------------------------------------------------------------------------------
// modern::plasmaPlanetSun, kPlasmaPlanetRadius, kPlasmaPlanetAir, the cloud layer and the clouds' albedo
// (src/modern/scenes/nebula.hpp).

const vec3 kPlanetSun = vec3(0.95, 0.27, 0.12) / length(vec3(0.95, 0.27, 0.12));
const float kPlanetAir = 60.0;
const float kCloudBase = 2.0;
const float kCloudTop = 5.5;
const vec3 kCloudAlbedo = vec3(0.9, 0.91, 0.93);
// The air (per unit length at the sea; 1 unit ~ 1 km): Rayleigh, blue, scale height 8; Mie haze, grey,
// scale height 1.2, forward scattering.
const vec3 kRayleigh = vec3(5.8e-3, 13.5e-3, 33.1e-3);
const float kRayleighHeight = 8.0;
const float kMie = 4e-3;
const float kMieHeight = 1.2;
const float kMieG = 0.8;
// The share of the air's extinction the grid holds (the rest of its light is the baked emission; the grid's
// own scattering of the air, with the clouds' albedo, stays small).
const float kAirHeld = 0.04;

// The air's optical depth from p towards the sun (6 steps, out to the top of the air), per colour.
vec3 planetSunDepth(vec3 p, float radius) {
    const float kSteps[6] = float[6](2.0, 6.0, 14.0, 30.0, 60.0, 120.0);
    vec3 depth = vec3(0.0);
    float s0 = 0.0;
    for (int i = 0; i < 6; ++i) {
        float s1 = kSteps[i];
        float h = max(length(p + kPlanetSun * (0.5 * (s0 + s1))) - radius, 0.0);
        depth += (kRayleigh * exp(-h / kRayleighHeight) + 1.1 * kMie * exp(-h / kMieHeight)) * (s1 - s0);
        s0 = s1;
    }
    return depth;
}

// How much of the sun's disc p sees past the planet: 0 in its shadow, a soft edge as wide as the disc.
float planetSunVisible(vec3 p, float radius) {
    float along = dot(p, kPlanetSun);
    if (along >= 0.0) {
        return 1.0;
    }
    float miss = length(p - kPlanetSun * along) - radius;
    return smoothstep(-0.0047 * abs(along), 0.0047 * abs(along), miss);
}

// The cumulus: cells drifting with the wind, flat bases and heaped tops, broken by erosion; sigma_t per unit.
float planetClouds(vec3 p, float altitude, float t) {
    float band = smoothstep(kCloudBase - 0.2, kCloudBase + 0.5, altitude) *
                 (1.0 - smoothstep(kCloudTop - 1.6, kCloudTop, altitude));
    if (!(band > 0.0)) {
        return 0.0;
    }
    vec3 q = p + vec3(-0.35 * t, 0.0, 0.12 * t);
    float cells = fbm(q * 0.055, 3);                  // systems, ~20 units
    float heap = fbm(q * 0.24 + vec3(3.1, 0.0, -7.7), 3); // cumulus, ~4 units
    // Billows: 3-D detail that grows towards the top, so the towers come out cauliflowered, not as slabs.
    float h = (altitude - kCloudBase) / (kCloudTop - kCloudBase);
    float billows = fbm(q * 0.9 + vec3(0.0, -0.2 * t, 0.0), 3);
    float cover = cells + 0.5 * heap + (0.12 + 0.25 * h) * billows; // about zero-mean (fbm is)
    // Heaped: the higher, the more cover a column needs to reach it (flat bases, rounded tops).
    float shape = smoothstep(0.0, 0.08, cover - 0.1 - 0.32 * h);
    float erosion = 0.3 * gradientNoise(q * 2.3);
    return 6.0 * band * clamp(shape * (1.0 + erosion), 0.0, 1.0);
}

vec4 planetVoxel(vec3 p, float t, float sunIrradiance, float radius, vec3 eye, bool withClouds) {
    float altitude = length(p) - radius;
    if (altitude < -0.5 || altitude > kPlanetAir) {
        return vec4(0.0);
    }
    float h = max(altitude, 0.0);
    vec3 rayleigh = kRayleigh * exp(-h / kRayleighHeight);
    float mie = kMie * exp(-h / kMieHeight);
    float clouds = withClouds ? planetClouds(p, altitude, t) : 0.0;
    float air = kAirHeld * (mie * 1.1 + dot(rayleigh, vec3(1.0 / 3.0)));
    float rho = clouds + air;
    // The air's single scattering of the sun towards the eye, attenuated on its way in from the sun.
    // The cosine between the sunlight's travel (-kPlanetSun) and the way on to the eye: 1 looking into the sun.
    float cosine = dot(-kPlanetSun, normalize(eye - p));
    float rayleighPhase = 0.0596831 * (1.0 + cosine * cosine); // 3 / (16 pi) (1 + cos^2)
    float g2 = kMieG * kMieG;                                     // Cornette-Shanks
    float miePhase = 0.119366 * (1.0 - g2) * (1.0 + cosine * cosine) /
                     ((2.0 + g2) * pow(max(1.0 + g2 - 2.0 * kMieG * cosine, 1e-4), 1.5));
    vec3 sun = sunIrradiance * planetSunVisible(p, radius) * exp(-planetSunDepth(p, radius));
    vec3 j = sun * (rayleigh * rayleighPhase + vec3(mie * miePhase));
    vec3 le = j / (max(rho, 1e-6) * (1.0 - kCloudAlbedo));
    return vec4(rho, le);
}

vec4 mediumVoxel(vec3 uvw, float seconds, vec4 params[4]) {
    vec3 lo = params[1].xyz, hi = params[2].xyz;
    vec3 p = mix(lo, hi, uvw);
    float t = params[0].y;
    if (params[0].x == 2.0) {
        return planetVoxel(p, t, params[0].z, params[1].w, params[3].xyz, params[2].w > 0.5);
    }
    if (params[0].x == 1.0) {
        return plasmaVoxel(p, t, params[3].x, params[3].y, lo, hi);
    }
    return nebulaVoxel(p, t, params[0].z, params[3].x, params[3].y, lo, hi, vec3(params[1].w, params[2].w, params[3].z),
                       params[3].w);
}
