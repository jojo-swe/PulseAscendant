#version 460
#extension GL_GOOGLE_include_directive : require

// The Nebula scene's stars (the Nebula): the frame's light tree, as an emissive sphere field. They are
// fixed in the cloud; only their size and brightness follow the music. Two modes (params[0].x):
//
// 0, NEBULA: particles 0, 1, 2 are the hero stars A, B and C (modern::kNebulaStarCentres and Radii); A's
//    radius breathes with the energy (params[0].z) and every star flares a little on the kick (params[0].w).
//    The rest are faint young stars buried in the pillars: particle id sits in pillar id % 4, at a hashed
//    height along its (bent) axis and a hashed offset inside it.
// 1, PLASMA: two stars in the slab, one in each of the 1993 palette's warm and cool families.
//
// params[0] = (mode, count, energy, kick). modern::nebulaStar (src/modern/scenes/nebula.cpp) mirrors
// particle() operation for operation; change both together (scene_nebula_test compares them).

#include "particles_common.glsl"

uint starHash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float starUnit(uint x) {
    return float(x >> 8) * (1.0 / 16777216.0);
}

const vec3 kHeroCentre[3] = vec3[3](vec3(20.0, 18.0, -90.0), vec3(-27.0, -10.0, -26.0), vec3(35.0, 16.0, -30.0));
const float kHeroRadius[3] = float[3](0.9, 0.8, 0.5);
const vec3 kHeroColour[3] = vec3[3](vec3(0.72, 0.82, 1.0), vec3(1.0, 0.93, 0.84), vec3(1.0, 0.74, 0.48));
const float kHeroEmission[3] = float[3](2800.0, 600.0, 800.0);

const vec3 kPillarBase[4] = vec3[4](vec3(-40.0, -48.0, -30.0), vec3(-2.0, -48.0, -38.0), vec3(32.0, -48.0, -26.0),
                                    vec3(60.0, -48.0, -44.0));
const vec3 kPillarTop[4] = vec3[4](vec3(-44.0, 30.0, -36.0), vec3(6.0, 46.0, -46.0), vec3(36.0, 14.0, -30.0),
                                   vec3(58.0, -6.0, -46.0));
const float kPillarBaseRadius[4] = float[4](11.0, 12.0, 9.0, 7.0);
const float kPillarTopRadius[4] = float[4](7.5, 8.0, 6.5, 5.0);
const vec3 kPillarBow[4] = vec3[4](vec3(-3.0, 0.0, 2.0), vec3(4.0, 0.0, -2.0), vec3(-2.5, 0.0, 3.0), vec3(2.0, 0.0, 0.0));

// Pillar i's bent axis and its radius at height fraction h (nebula_medium.comp's).
vec3 pillarAxis(uint i, float h) {
    float fi = float(i);
    return kPillarBase[i] + (kPillarTop[i] - kPillarBase[i]) * h + kPillarBow[i] * sin(3.14159265 * h) +
           vec3(1.6 * sin(5.1 * h + 1.7 * fi), 0.0, 1.6 * cos(4.3 * h + 2.3 * fi));
}

float pillarRadius(uint i, float h) {
    float head = (h - 0.9) / 0.08;
    return (kPillarBaseRadius[i] + (kPillarTopRadius[i] - kPillarBaseRadius[i]) * h) *
               (1.0 + 0.16 * sin(8.7 * h + 1.3 * float(i))) +
           0.45 * kPillarTopRadius[i] * exp(-head * head);
}

SphereRecord particle(uint id, float seconds, vec4 params[4]) {
    SphereRecord s;
    s.prevCenter = vec3(0.0);
    s.material = 0u;
    float energy = params[0].z;
    float kick = params[0].w;
    if (params[0].x == 1.0) {
        bool warm = id == 0u;
        s.center = warm ? vec3(-7.0, 3.0, 0.5) : vec3(8.0, -4.0, -1.5);
        s.radius = 0.22 * (1.0 + 0.15 * energy);
        s.color = warm ? vec3(1.0, 0.62, 0.22) : vec3(0.35, 0.5, 1.0);
        s.emission = 220.0 * (1.0 + 0.5 * kick);
        return s;
    }
    if (id < 3u) {
        s.center = kHeroCentre[id];
        s.radius = kHeroRadius[id] * (id == 0u ? 1.0 + 0.22 * energy : 1.0);
        s.color = kHeroColour[id];
        s.emission = kHeroEmission[id] * (1.0 + 0.3 * kick);
        return s;
    }
    uint h = starHash(id * 0x9E3779B9u + 0x51EDu);
    uint i = id % 4u;
    float along = 0.15 + 0.8 * starUnit(h);
    float angle = 6.2831853 * starUnit(starHash(h));
    float reach = 0.55 * starUnit(starHash(h ^ 0x68E31DA4u));
    vec3 axis = kPillarTop[i] - kPillarBase[i];
    vec3 side = normalize(cross(axis, vec3(0.0, 0.0, 1.0)));
    vec3 other = normalize(cross(axis, side));
    s.center = pillarAxis(i, along) + pillarRadius(i, along) * reach * (cos(angle) * side + sin(angle) * other);
    float shade = starUnit(starHash(h + 7u));
    s.radius = 0.12 + 0.1 * shade;
    s.color = vec3(1.0, 0.72 + 0.18 * shade, 0.45 + 0.35 * shade);
    s.emission = 260.0 + 200.0 * shade;
    return s;
}
