#version 460
#extension GL_GOOGLE_include_directive : require

// The caustic maps' resolve (caustic photon maps; modern::CausticMaps records it after photons.comp): one
// invocation per texel of one layer (push constants). A receiver's texel within its resolution gets the
// irradiance its fixed-point flux sums stand for, filtered by a 3x3 tent (1 2 1 / 4 per axis, which keeps
// the energy), clamped to RGBA16F's largest value; every other texel, and a layer without a receiver, 0.
//
// The chroma filter (a receiver's chromaRadius r > 0; glass). Each photon of dispersive glass
// carries one wavelength, so a texel's colour converges far slower than its brightness: at a few hundred
// photons per tent the rainbow is speckled with every hue. The filter keeps the tent's luminance and takes
// the colour from a wider window, 5 x 5 tent sums r / 2 texels apart (about (2r + 1)^2 texels):
// E = Y(tent) * wide / Y(wide). Edges and the caustic's fine structure stay as sharp as the tent's; only
// the hue is averaged, over a few centimetres where dispersion changes it slowly. Where the wide window holds
// no light the tent is kept. Deterministic, like everything else here.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, std430) readonly buffer AccumulatorBlock { uint accumulator[]; };
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray maps;

layout(push_constant) uniform Push {
    uint layer;
    uint resolution;        // the receiver's (0: no receiver on this layer)
    uint mapSize;           // the accumulator's and the maps' texels per side
    float irradianceScale;  // irradiance per fixed-point unit: flux per unit / texel area
    uint chromaRadius;      // 0: no chroma filter
} pc;

vec3 sums(ivec2 texel) {
    if (texel.x < 0 || texel.y < 0 || texel.x >= int(pc.resolution) || texel.y >= int(pc.resolution)) {
        return vec3(0.0);
    }
    uint index = (pc.layer * pc.mapSize * pc.mapSize + uint(texel.y) * pc.mapSize + uint(texel.x)) * 3u;
    return vec3(float(accumulator[index]), float(accumulator[index + 1u]), float(accumulator[index + 2u]));
}

// The 3x3 tent (1 2 1 / 4 per axis) of the sums around a texel, unnormalised (x 16).
vec3 tent(ivec2 texel) {
    vec3 e = vec3(0.0);
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            float w = (dx == 0 ? 2.0 : 1.0) * (dy == 0 ? 2.0 : 1.0);
            e += w * sums(texel + ivec2(dx, dy));
        }
    }
    return e;
}

float lumaOf(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= int(pc.mapSize) || texel.y >= int(pc.mapSize)) {
        return;
    }
    vec3 e = vec3(0.0);
    if (texel.x < int(pc.resolution) && texel.y < int(pc.resolution)) {
        e = tent(texel);
        if (pc.chromaRadius > 0u && lumaOf(e) > 0.0) {
            int step = max(int(pc.chromaRadius) / 2, 1);
            vec3 wide = vec3(0.0);
            for (int dy = -2; dy <= 2; ++dy) {
                for (int dx = -2; dx <= 2; ++dx) {
                    wide += tent(texel + ivec2(dx, dy) * step);
                }
            }
            float y = lumaOf(wide);
            if (y > 0.0) {
                e = wide * (lumaOf(e) / y);
            }
        }
        e = min(e * (pc.irradianceScale / 16.0), vec3(65504.0));
    }
    imageStore(maps, ivec3(texel, int(pc.layer)), vec4(e, 1.0));
}
