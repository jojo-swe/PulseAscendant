#version 460
#extension GL_GOOGLE_include_directive : require

// The 2026 picture's one tonemap and its one display encoding: HDR linear light (RGBA16F)
// -> * 2^exposureEV -> max(0) per component -> the bloom mix (1 - w) I + w B -> the vignette -> Khronos PBR
// Neutral -> clamp [0, 1] -> the act's grade in linear display light (S-curve, black lift, split tone, shadow
// desaturation, grain) -> sRGB OETF -> the palette mix -> round(v * 255 + d (1 - palette)) with d a static
// triangular dither in (-0.5, 0.5) from pcg(x, y), the same for all three channels -> RGBA8 UNORM. A
// non-finite component counts as 0. Every step after PBR Neutral's input is skipped when its parameter is 0,
// so the ungraded tonemap writes the bytes it always did. Must match src/post/tonemap_reference.cpp.

#include "../rt/random.glsl"
#include "neutral.glsl"
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D hdrImage;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D ldrImage;
// post::Bloom's picture at half size (rounded up): the HDR image convolved with the lens PSF.
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D bloomImage;
// The palette the grade mixes toward: each entry's Oklab (xyz) and its sRGB-encoded colour (RGBA8, red in the
// low byte), both computed on the CPU (post::gradePaletteTable).
layout(std430, set = 0, binding = 3) readonly buffer PaletteBuffer {
    vec4 paletteLab[256];
    uint paletteColor[256];
};

// Must match TonemapPush in src/post/tonemap.cpp (56 bytes).
layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    float exposureScale; // 2^exposureEV, computed on the CPU like the reference does
    float bloomWeight;
    float splitTone;
    float contrast;
    float shadowDesaturation;
    float grain;
    float liftR;
    float liftG;
    float liftB;
    uint grainFrame;
    float vignette;
    float paletteWeight;
} pc;

// A uniform in (0, 1) from the hash's top 23 bits plus a half step: exact in float, never 0 or 1.
float openUnit(uint h) {
    return (float(h >> 9u) + 0.5) * (1.0 / 8388608.0);
}

float dither(uvec2 pixel) {
    uint first = pcgHash(pixel.x ^ pcgHash(pixel.y));
    uint second = pcgHash(first);
    return 0.5 * (openUnit(first) + openUnit(second)) - 0.5;
}

// The grain of a pixel in a frame: triangular, zero mean, unit standard deviation (the sum of two uniforms
// minus 1 has the standard deviation 1 / sqrt(6)).
float grainNoise(uvec2 pixel, uint frame) {
    uint first = pcgHash(pixel.x ^ pcgHash(pixel.y ^ pcgHash(frame ^ 0x6772616eu)));
    uint second = pcgHash(first);
    return (openUnit(first) + openUnit(second) - 1.0) * 2.4494897;
}

// The vignette's falloff: 1 - v r^2, with r = 0 at the centre and 1 in the corners.
float vignetteFactor(uvec2 pixel) {
    float w = float(pc.width), h = float(pc.height);
    float u = (2.0 * float(pixel.x) + 1.0) / w - 1.0;
    float v = (2.0 * float(pixel.y) + 1.0) / h - 1.0;
    return 1.0 - pc.vignette * ((u * u * w * w + v * v * h * h) / (w * w + h * h));
}

// The bloom picture at a full-size pixel: bilinear from the half-size image (the pixel centre p + 0.5 lands
// on (p + 0.5) / 2 there), clamped to the edge.
vec3 bloomAt(uvec2 pixel) {
    ivec2 high = imageSize(bloomImage) - 1;
    vec2 base = vec2(pixel) * 0.5 - 0.25;
    ivec2 origin = ivec2(floor(base));
    vec2 f = base - vec2(origin);
    vec3 a = imageLoad(bloomImage, clamp(origin, ivec2(0), high)).rgb;
    vec3 b = imageLoad(bloomImage, clamp(origin + ivec2(1, 0), ivec2(0), high)).rgb;
    vec3 c = imageLoad(bloomImage, clamp(origin + ivec2(0, 1), ivec2(0), high)).rgb;
    vec3 d = imageLoad(bloomImage, clamp(origin + ivec2(1, 1), ivec2(0), high)).rgb;
    return (a * (1.0 - f.x) + b * f.x) * (1.0 - f.y) + (c * (1.0 - f.x) + d * f.x) * f.y;
}

// The S-curve on display luminance: f(0) = 0, f(1) = 1, f(kMidGrey) = kMidGrey with the slope 1 + k there
// and 1 - k at both ends; a quadratic on each side of the pivot.
const float kMidGrey = 0.18;
float sCurve(float x, float k) {
    if (x <= kMidGrey) {
        float t = x / kMidGrey;
        return kMidGrey * t * (1.0 + k * (t - 1.0));
    }
    float u = (1.0 - x) / (1.0 - kMidGrey);
    return 1.0 - (1.0 - kMidGrey) * u * (1.0 + k * (u - 1.0));
}

// Linear sRGB -> Oklab (Ottosson's matrices).
vec3 oklab(vec3 c) {
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
    l = pow(max(l, 0.0), 1.0 / 3.0);
    m = pow(max(m, 0.0), 1.0 / 3.0);
    s = pow(max(s, 0.0), 1.0 / 3.0);
    return vec3(0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
                1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
                0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s);
}

// The act's grade of a display colour in [0, 1] (linear light), in its fixed order.
vec3 grade(vec3 c, uvec2 pixel) {
    if (pc.contrast != 0.0) {
        float y = luminance(c);
        if (y > 0.0) {
            c = min(c * (sCurve(y, pc.contrast) / y), vec3(1.0));
        }
    }
    vec3 lift = vec3(pc.liftR, pc.liftG, pc.liftB);
    if (lift != vec3(0.0)) {
        c = lift + c * (1.0 - lift);
    }
    if (pc.splitTone != 0.0) {
        // Warm at black, neutral at 0.5, cool at white; the tint direction carries no luminance.
        const vec3 warm = vec3(1.0, -0.19630872, -1.0);
        c = clamp(c * (1.0 + pc.splitTone * (1.0 - 2.0 * luminance(c)) * warm), 0.0, 1.0);
    }
    if (pc.shadowDesaturation != 0.0) {
        float y = luminance(c);
        float shadow = 1.0 - min(2.0 * y, 1.0);
        c = clamp(y + (c - y) * (1.0 - pc.shadowDesaturation * shadow * shadow), 0.0, 1.0);
    }
    if (pc.grain != 0.0) {
        c = clamp(c * (1.0 + pc.grain * grainNoise(pixel, pc.grainFrame)), 0.0, 1.0);
    }
    return c;
}

// The sRGB-encoded colour of the palette entry nearest to a linear colour in Oklab (the lowest index on a
// tie).
vec3 nearestPaletteColor(vec3 c) {
    vec3 lab = oklab(c);
    uint best = 0u;
    float bestDistance = 1e30;
    for (uint i = 0u; i < 256u; ++i) {
        vec3 d = lab - paletteLab[i].xyz;
        float distance = dot(d, d);
        if (distance < bestDistance) {
            bestDistance = distance;
            best = i;
        }
    }
    return unpackUnorm4x8(paletteColor[best]).rgb;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }

    // Negative light is clamped to 0 per component: PBR Neutral is defined on non-negative light.
    vec3 hdr = max(finiteOrZero(imageLoad(hdrImage, ivec2(pixel)).rgb) * pc.exposureScale, 0.0);
    if (pc.bloomWeight != 0.0) {
        vec3 bloom = max(finiteOrZero(bloomAt(pixel)) * pc.exposureScale, 0.0);
        hdr = (1.0 - pc.bloomWeight) * hdr + pc.bloomWeight * bloom;
    }
    if (pc.vignette != 0.0) {
        hdr *= vignetteFactor(pixel);
    }
    vec3 linear = grade(clamp(pbrNeutral(hdr), 0.0, 1.0), pixel);
    vec3 display = srgbOetf(linear);
    float spread = 1.0;
    if (pc.paletteWeight != 0.0) {
        // In encoded display values, so the dissolve looks even; at weight 1 the byte is the entry's.
        display = display * (1.0 - pc.paletteWeight) + nearestPaletteColor(linear) * pc.paletteWeight;
        spread = 1.0 - pc.paletteWeight;
    }
    vec3 bytes = clamp(floor(display * 255.0 + dither(pixel) * spread + 0.5), 0.0, 255.0);
    imageStore(ldrImage, ivec2(pixel), vec4(bytes / 255.0, 1.0));
}
