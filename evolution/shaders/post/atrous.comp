#version 460

// One à-trous iteration of the denoiser: a 5x5 B3 kernel (1/16, 1/4, 3/8) with taps `step` pixels apart,
// each weighted by depth, normal and luminance edge stops; the variance travels with squared weights so the
// next, wider iteration stops at a smaller luminance difference. A negative variance marks a sparse pixel
// of a short history (accumulate.comp): the first pass filters it by depth and normal only, and every pass
// uses the magnitude. A miss (depth <= 0) is copied unfiltered
// and never taken as a tap (as is a non-finite depth). A pixel whose history is longer than copyAbove frames
// is copied as well: the extra iterations a short history gets (resetAtrousIterations) leave the others.
//
// With `volume` set it filters the volume layer instead (RGB in-scattered radiance, A transmittance): every
// pixel, every tap inside the image, weighted by luminance alone (a medium has no depth or normal); the
// luminance stop scales with the standard deviation of the 3x3 neighbourhood at step 1; the transmittance is
// copied, never blurred, since it carries the silhouettes of the surfaces it multiplies.

#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D source; // RGB illumination, A variance
layout(set = 0, binding = 1, r32f) uniform readonly image2D depthImage;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D normalImage;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D target;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D momentsImage; // R history length

// Must match AtrousPush in src/post/denoiser.cpp (32 bytes).
layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint step;
    float sigmaDepth;
    float sigmaNormal;
    float sigmaLuminance;
    uint copyAbove; // pixels with a longer history are copied (0xFFFFFFFF: none)
    uint volume;    // 1: the volume layer
} pc;

const float kKernel[3] = float[3](3.0 / 8.0, 1.0 / 4.0, 1.0 / 16.0);
const float kGauss[2] = float[2](1.0 / 2.0, 1.0 / 4.0);

ivec2 clampToImage(ivec2 q) {
    return clamp(q, ivec2(0), ivec2(int(pc.width) - 1, int(pc.height) - 1));
}

bool inside(ivec2 q) {
    return q.x >= 0 && q.y >= 0 && q.x < int(pc.width) && q.y < int(pc.height);
}

void filterVolume(ivec2 p) {
    vec4 centre = imageLoad(source, p);
    float lum = luminance(centre.rgb);
    float mean = 0.0, meanSquare = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            float l = luminance(imageLoad(source, clampToImage(p + ivec2(dx, dy))).rgb);
            float g = kGauss[abs(dx)] * kGauss[abs(dy)];
            mean += g * l;
            meanSquare += g * l * l;
        }
    }
    float phiLuminance = pc.sigmaLuminance * sqrt(max(meanSquare - mean * mean, 0.0)) + 1e-4;
    // The weighted mean as centre + sum(w (tap - centre)) / sum(w): exactly the centre on a constant layer.
    vec3 sum = vec3(0.0);
    float sumWeight = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            ivec2 q = p + ivec2(dx, dy) * int(pc.step);
            if (!inside(q)) {
                continue;
            }
            vec3 tap = imageLoad(source, q).rgb;
            float w = kKernel[abs(dx)] * kKernel[abs(dy)] * exp(-abs(lum - luminance(tap)) / phiLuminance);
            sum += w * (tap - centre.rgb);
            sumWeight += w;
        }
    }
    // sumWeight >= the centre's 9/64.
    imageStore(target, p, vec4(max(centre.rgb + sum / sumWeight, vec3(0.0)), centre.a));
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) {
        return;
    }
    if (pc.volume != 0u) {
        filterVolume(p);
        return;
    }

    vec4 centre = imageLoad(source, p);
    float depth = imageLoad(depthImage, p).r;
    float historyLength = imageLoad(momentsImage, p).r;
    if (!isHit(depth) || historyLength > float(pc.copyAbove)) {
        imageStore(target, p, centre);
        return;
    }
    vec3 normal = imageLoad(normalImage, p).xyz;
    float lum = luminance(centre.rgb);

    // The luminance edge stop scales with the local standard deviation: a 3x3 Gaussian of the variance.
    float variance = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            variance +=
                kGauss[abs(dx)] * kGauss[abs(dy)] * abs(imageLoad(source, clampToImage(p + ivec2(dx, dy))).a);
        }
    }
    float phiLuminance = pc.sigmaLuminance * sqrt(max(variance, 0.0)) + 1e-4;
    bool sparse = pc.step == 1u && centre.a < 0.0; // no luminance stop on raw sparse samples
    float phiDepth = pc.sigmaDepth * float(pc.step) * 0.01 * max(depth, 1e-3);

    vec3 sum = vec3(0.0);
    float sumWeight = 0.0;
    float sumVariance = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            ivec2 q = p + ivec2(dx, dy) * int(pc.step);
            if (!inside(q)) {
                continue;
            }
            float k = kKernel[abs(dx)] * kKernel[abs(dy)];
            vec4 tap = centre;
            float w = 1.0; // the centre tap
            if (dx != 0 || dy != 0) {
                float qDepth = imageLoad(depthImage, q).r;
                if (!isHit(qDepth)) {
                    continue;
                }
                tap = imageLoad(source, q);
                vec3 qNormal = imageLoad(normalImage, q).xyz;
                w = exp(-abs(depth - qDepth) / phiDepth) * normalWeight(normal, qNormal, pc.sigmaNormal) *
                    (sparse ? 1.0 : exp(-abs(lum - luminance(tap.rgb)) / phiLuminance));
            }
            float kw = k * w;
            sum += kw * tap.rgb;
            sumWeight += kw;
            sumVariance += kw * kw * abs(tap.a);
        }
    }
    // sumWeight >= the centre's 9/64.
    imageStore(target, p, vec4(sum / sumWeight, min(sumVariance / (sumWeight * sumWeight), kHalfMax)));
}
