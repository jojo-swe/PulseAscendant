#version 460

// The temporal upscaler (src/post/upscale.hpp has the full description): the trace-size HDR picture to the
// output size. Per output pixel: a spatial Catmull-Rom upsample of the current frame at its jittered sample
// grid; a sharp estimate from the current samples near the pixel centre with its weight; the previous output
// reprojected with the motion guide (nearest depth in 3x3), clipped to the current neighbourhood's YCoCg
// mean +- gamma sigma box, and blended by weight. The primary-hit emission (min(emission, hdr) per trace
// pixel) bypasses the history: only its spatial upsample is added to the output, so an emissive screen
// always shows the current frame. With the identity flag (equal sizes) a plain copy.

#extension GL_GOOGLE_include_directive : require

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D hdrImage;      // trace size
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D emissionImage; // trace size (flag)
layout(set = 0, binding = 2, r32f) uniform readonly image2D depthImage;       // trace size, -1 on a miss
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D motionImage;   // trace size, trace pixels
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D historyIn;     // output size: RGB, A weight
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D historyOut;   // output size
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D outImage;     // output size

const uint kFlagIdentity = 1u; // equal sizes: copy
const uint kFlagHistory = 2u;  // the history may be used this frame
const uint kFlagEmission = 4u; // emissionImage holds the primary-hit emission

// Must match UpscalePush in src/post/upscale.cpp (36 bytes).
layout(push_constant) uniform PushConstants {
    uint inWidth, inHeight, outWidth, outHeight;
    vec2 jitter; // this frame's sample offset from each trace pixel's centre, in trace pixels
    float feedback;
    float clipGamma;
    uint flags;
} pc;

// A colour input made safe: non-finite components 0, clamped to [0, half maximum].
vec3 safeColor(vec4 c) {
    return clamp(finiteOrZero(c.rgb), vec3(0.0), vec3(kHalfMax));
}

ivec2 clampIn(ivec2 p) {
    return clamp(p, ivec2(0), ivec2(pc.inWidth, pc.inHeight) - 1);
}

// A trace pixel's temporal part (the colour without its emission) and its emission.
void texel(ivec2 p, out vec3 rest, out vec3 emission) {
    p = clampIn(p);
    vec3 hdr = safeColor(imageLoad(hdrImage, p));
    emission = (pc.flags & kFlagEmission) != 0u ? min(safeColor(imageLoad(emissionImage, p)), hdr) : vec3(0.0);
    rest = hdr - emission;
}

vec4 catmullRomWeights(float t) {
    float t2 = t * t, t3 = t2 * t;
    return 0.5 * vec4(-t3 + 2.0 * t2 - t, 3.0 * t3 - 5.0 * t2 + 2.0, -3.0 * t3 + 4.0 * t2 + t, t3 - t2);
}

// RGB <-> YCoCg.
vec3 toYCoCg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}
vec3 fromYCoCg(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

// h moved along the line towards mu until it is inside the box mu +- extent.
vec3 clipToBox(vec3 h, vec3 mu, vec3 extent) {
    vec3 d = h - mu;
    vec3 units = abs(d) / max(extent, vec3(1e-4));
    float m = max(units.x, max(units.y, units.z));
    return m > 1.0 ? mu + d / m : h;
}

void main() {
    ivec2 o = ivec2(gl_GlobalInvocationID.xy);
    if (o.x >= int(pc.outWidth) || o.y >= int(pc.outHeight)) {
        return;
    }
    if ((pc.flags & kFlagIdentity) != 0u) {
        imageStore(outImage, o, imageLoad(hdrImage, o));
        return;
    }

    vec2 inSize = vec2(pc.inWidth, pc.inHeight), outSize = vec2(pc.outWidth, pc.outHeight);
    vec2 scale = inSize / outSize;             // trace pixels per output pixel
    vec2 centre = vec2(o) + 0.5;               // output pixels
    vec2 q = centre * scale - 0.5 - pc.jitter; // on the jittered grid: texel i sits at i

    // The spatial term: Catmull-Rom over 4x4 texels, clamped to the 2x2 nearest (no ringing, never negative).
    ivec2 base = ivec2(floor(q));
    vec2 t = q - vec2(base);
    vec4 wx = catmullRomWeights(t.x), wy = catmullRomWeights(t.y);
    vec3 spatialRest = vec3(0.0), spatialEmission = vec3(0.0);
    vec3 restLo = vec3(kHalfMax), restHi = vec3(0.0), emissionLo = vec3(kHalfMax), emissionHi = vec3(0.0);
    for (int j = 0; j < 4; ++j) {
        for (int i = 0; i < 4; ++i) {
            vec3 rest, emission;
            texel(base + ivec2(i - 1, j - 1), rest, emission);
            float w = wx[i] * wy[j];
            spatialRest += w * rest;
            spatialEmission += w * emission;
            if ((i == 1 || i == 2) && (j == 1 || j == 2)) {
                restLo = min(restLo, rest);
                restHi = max(restHi, rest);
                emissionLo = min(emissionLo, emission);
                emissionHi = max(emissionHi, emission);
            }
        }
    }
    spatialRest = clamp(spatialRest, restLo, restHi);
    spatialEmission = clamp(spatialEmission, emissionLo, emissionHi);

    vec3 result = spatialRest;
    float weight = 1.0;
    if ((pc.flags & kFlagHistory) != 0u) {
        // The current samples of the 3x3 trace pixels around the nearest: the sharp estimate (weighted by the
        // distance from this pixel's centre), the neighbourhood statistics, and the nearest depth's motion.
        ivec2 nearest = ivec2(floor(q + 0.5));
        vec3 sharp = vec3(0.0), m1 = vec3(0.0), m2 = vec3(0.0);
        float sharpWeight = 0.0;
        float nearestDepth = 1e30;
        ivec2 motionTexel = clampIn(nearest);
        for (int j = -1; j <= 1; ++j) {
            for (int i = -1; i <= 1; ++i) {
                ivec2 p = nearest + ivec2(i, j);
                vec3 rest, emission;
                texel(p, rest, emission);
                vec2 samplePosition = (vec2(p) + 0.5 + pc.jitter) / scale; // output pixels
                vec2 d = samplePosition - centre;
                float w = exp(-8.0 * dot(d, d));
                sharp += w * rest;
                sharpWeight += w;
                vec3 c = toYCoCg(rest);
                m1 += c;
                m2 += c * c;
                float depth = imageLoad(depthImage, clampIn(p)).r;
                if (isHit(depth) && depth < nearestDepth) {
                    nearestDepth = depth;
                    motionTexel = clampIn(p);
                }
            }
        }
        sharp /= max(sharpWeight, 1e-6);
        vec3 mean = m1 / 9.0;
        vec3 sigma = sqrt(max(m2 / 9.0 - mean * mean, vec3(0.0)));

        vec4 motion = imageLoad(motionImage, motionTexel);
        bool valid = motion.z > 0.5 && isFinite(motion.x) && isFinite(motion.y);
        vec2 previous = centre + motion.xy / scale; // output pixels
        valid = valid && all(greaterThanEqual(previous, vec2(0.0))) && all(lessThan(previous, outSize));
        if (valid) {
            // The history: Catmull-Rom colour clamped to its 2x2 nearest, bilinear weight.
            vec2 hq = previous - 0.5;
            ivec2 hb = ivec2(floor(hq));
            vec2 ht = hq - vec2(hb);
            vec4 hx = catmullRomWeights(ht.x), hy = catmullRomWeights(ht.y);
            vec3 history = vec3(0.0), lo = vec3(kHalfMax), hi = vec3(0.0);
            float historyWeight = 0.0;
            for (int j = 0; j < 4; ++j) {
                for (int i = 0; i < 4; ++i) {
                    ivec2 p = clamp(hb + ivec2(i - 1, j - 1), ivec2(0), ivec2(outSize) - 1);
                    vec4 h = imageLoad(historyIn, p);
                    vec3 c = safeColor(h);
                    history += hx[i] * hy[j] * c;
                    if ((i == 1 || i == 2) && (j == 1 || j == 2)) {
                        lo = min(lo, c);
                        hi = max(hi, c);
                        float bx = i == 1 ? 1.0 - ht.x : ht.x, by = j == 1 ? 1.0 - ht.y : ht.y;
                        historyWeight += bx * by * (isFinite(h.a) ? clamp(h.a, 0.0, kHalfMax) : 0.0);
                    }
                }
            }
            history = clamp(history, lo, hi);
            history = max(fromYCoCg(clipToBox(toYCoCg(history), mean, pc.clipGamma * sigma)), vec3(0.0));
            historyWeight *= pc.feedback;
            if (historyWeight > 0.0) {
                weight = historyWeight + sharpWeight;
                result = (history * historyWeight + sharp * sharpWeight) / weight;
            }
        }
    }

    result = min(result, vec3(kHalfMax));
    imageStore(historyOut, o, vec4(result, min(weight, kHalfMax)));
    imageStore(outImage, o, vec4(min(result + spatialEmission, vec3(kHalfMax)), 1.0));
}
