#version 460
#extension GL_GOOGLE_include_directive : require

// post::Bloom's diffraction and streak, at the chain's quarter size: a six-blade aperture spreads a point
// into three lines through it, at 0, 60 and 120 degrees. Each is a line blur of the quarter-size picture,
// taps 1 pixel apart out to kSpokeTaps on both sides with weights exp(-|i| / kSpokeDecay), normalised; the
// three are averaged. With a streak share, one long horizontal line (the anamorphic streak) is added the
// same way. Writes spokeShare * spokes + streakShare * streak: what the last upsampling adds to the halo.
// Every line blur keeps the energy (its weights sum to 1 and a constant offset moves light without losing
// it), so the bloom does too.

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D target;

// Must match SpokesPush in src/post/bloom.cpp (16 bytes).
layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    float spokeShare;
    float streakShare;
} pc;

const int kSpokeTaps = 24;
const float kSpokeDecay = 6.0;
const int kStreakTaps = 48; // 2 pixels apart
const float kStreakDecay = 40.0;

vec3 bilinear(vec2 position) {
    ivec2 high = ivec2(int(pc.width) - 1, int(pc.height) - 1);
    ivec2 origin = ivec2(floor(position));
    vec2 f = position - vec2(origin);
    vec3 a = imageLoad(source, clamp(origin, ivec2(0), high)).rgb;
    vec3 b = imageLoad(source, clamp(origin + ivec2(1, 0), ivec2(0), high)).rgb;
    vec3 c = imageLoad(source, clamp(origin + ivec2(0, 1), ivec2(0), high)).rgb;
    vec3 d = imageLoad(source, clamp(origin + ivec2(1, 1), ivec2(0), high)).rgb;
    return (a * (1.0 - f.x) + b * f.x) * (1.0 - f.y) + (c * (1.0 - f.x) + d * f.x) * f.y;
}

vec3 lineBlur(vec2 p, vec2 direction, int taps, float spacing, float decay) {
    vec3 sum = vec3(0.0);
    float sumWeight = 0.0;
    for (int i = -taps; i <= taps; ++i) {
        float w = exp(-abs(float(i)) * spacing / decay);
        sum += w * bilinear(p + float(i) * spacing * direction);
        sumWeight += w;
    }
    return sum / sumWeight;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.width) || p.y >= int(pc.height)) {
        return;
    }
    vec2 centre = vec2(p);
    vec3 result = vec3(0.0);
    if (pc.spokeShare > 0.0) {
        const vec2 directions[3] = vec2[3](vec2(1.0, 0.0), vec2(0.5, 0.86602540), vec2(-0.5, 0.86602540));
        vec3 spokes = vec3(0.0);
        for (int d = 0; d < 3; ++d) {
            spokes += lineBlur(centre, directions[d], kSpokeTaps, 1.0, kSpokeDecay);
        }
        result += pc.spokeShare * (spokes / 3.0);
    }
    if (pc.streakShare > 0.0) {
        result += pc.streakShare * lineBlur(centre, vec2(1.0, 0.0), kStreakTaps, 2.0, kStreakDecay);
    }
    imageStore(target, p, vec4(result, 1.0));
}
